# Neon pooled connection string (dev branch). Use the "Pooled connection" string from the Neon console.
# For fully offline development run `npm run db:local` and use:
#   postgres://postgres:password@localhost:54329/samrin
DATABASE_URL=

# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — rows are hidden on /contact when unset
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Delivery fee in LKR (e.g. 350 or 350.00). Leave empty = no fee charged, "confirmed by our team".
DELIVERY_FEE_LKR=

# Optional: secret for signing anti-spam form tokens (defaults to a hash of DATABASE_URL)
FORM_SECRET=

# Payment provider id (see src/lib/payments). Defaults to "manual": payment confirmed by the team.
PAYMENT_PROVIDER=manual

# Admin dashboard (/admin). Leave empty to disable. Use a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: secret used to sign the admin session cookie (defaults to a hash of DATABASE_URL)
ADMIN_SESSION_SECRET=
# Optional: folder for uploaded product images (default ./uploads)
UPLOAD_DIR=
